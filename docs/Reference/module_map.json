        },
        {
          "option": "mors",
          "entry": "src/proteus/star/wrapper.py:init_star",
          "role": "Stellar evolution via the mors package"
        },
        {
          "option": null,
          "entry": null,
          "role": "No stellar evolution"
        }
      ],
      "sub_dispatches": [
        {
          "switch": "`star.mors.tracks`",
          "entry": "src/proteus/star/wrapper.py:get_new_spectrum",
